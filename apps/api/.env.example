# ==========================================
# DAYFLOW HRMS - Backend Environment Config
# ==========================================

# Application
PORT=3000
NODE_ENV=development
APP_NAME=DAYFLOW_HRMS_API

# Database (PostgreSQL Connection String)
# For local PostgreSQL or Docker/Cloud database:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow_hrms?schema=public"

# JWT Authentication
JWT_SECRET="dayflow-super-secure-hackathon-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Allows frontend access)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Aadhaar / e-KYC Verification Provider
# Options: 'mock' (for hackathon/local testing), 'sandbox', 'live'
AADHAAR_PROVIDER_MODE="mock"
AADHAAR_API_URL="https://api.aadhaar-sandbox.uidai.gov.in/v1/verify"
AADHAAR_API_KEY="mock_aadhaar_api_key_sample"

# Throttling / Rate Limiting (Requests per minute)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
